{"nodes": [{"id": "vibe_crafted_public_case_studies_feature_drift_mcr_case_study", "label": "Identifying Feature Drift Case Study", "file_type": "document", "source_file": "vibe-crafted/public/case-studies/feature-drift-mcr.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "vibe_crafted_public_case_studies_feature_drift_mcr_feature_drift_dissertation", "label": "Identifying Feature Drift (MSc Dissertation)", "file_type": "concept", "source_file": "vibe-crafted/public/case-studies/feature-drift-mcr.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Whether concept drift is observable through variable importance depends on what the statistic is computed from, a choice usually made implicitly."}, {"id": "vibe_crafted_public_case_studies_feature_drift_mcr_uon_msc_business_analytics", "label": "MSc Business Analytics, University of Nottingham", "file_type": "concept", "source_file": "vibe-crafted/public/case-studies/feature-drift-mcr.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "vibe_crafted_public_case_studies_feature_drift_mcr_frozen_model_conditional_drift", "label": "Frozen Model Cannot See Conditional Drift", "file_type": "rationale", "source_file": "vibe-crafted/public/case-studies/feature-drift-mcr.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When P(y|X) moves but P(X) holds, any label-free statistic from a frozen model has nothing to respond to; refitting on a recent window measures the current concept but needs labels."}, {"id": "vibe_crafted_public_case_studies_feature_drift_mcr_boolean_harness", "label": "Boolean Ground-Truth Harness (Arm A)", "file_type": "concept", "source_file": "vibe-crafted/public/case-studies/feature-drift-mcr.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "vibe_crafted_public_case_studies_feature_drift_mcr_rotating_hyperplane", "label": "Rotating Hyperplane Benchmark (Arm B)", "file_type": "concept", "source_file": "vibe-crafted/public/case-studies/feature-drift-mcr.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "200k instances x 10 features in 200 windows; P(X) stationary while P(y|X) rotates."}, {"id": "vibe_crafted_public_case_studies_feature_drift_mcr_refitted_shap_signal", "label": "Refitted SHAP Departure Signal (S1)", "file_type": "concept", "source_file": "vibe-crafted/public/case-studies/feature-drift-mcr.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alarmed at window 1 vs degradation at window 8: a seven-window lead resting on a 0.0030 margin."}, {"id": "vibe_crafted_public_case_studies_feature_drift_mcr_frozen_shap_signal", "label": "Frozen-Model SHAP Signal (S2)", "file_type": "concept", "source_file": "vibe-crafted/public/case-studies/feature-drift-mcr.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No sustained alarm; on the harness it moved opposite to the truth."}, {"id": "vibe_crafted_public_case_studies_feature_drift_mcr_vote_dominance", "label": "Ensemble Vote Dominance (S3)", "file_type": "concept", "source_file": "vibe-crafted/public/case-studies/feature-drift-mcr.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "vibe_crafted_public_case_studies_feature_drift_mcr_sufficient_subsets", "label": "Exact Sufficient-Subset Structure (S4)", "file_type": "concept", "source_file": "vibe-crafted/public/case-studies/feature-drift-mcr.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "vibe_crafted_public_case_studies_feature_drift_mcr_bootstrap_null_band", "label": "Bootstrap Null Band with 3-Window Persistence", "file_type": "rationale", "source_file": "vibe-crafted/public/case-studies/feature-drift-mcr.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without a null band 'the importance moved' is unfalsifiable since importance always moves a bit."}, {"id": "vibe_crafted_public_case_studies_feature_drift_mcr_permutation_controls", "label": "Permutation Negative Controls", "file_type": "rationale", "source_file": "vibe-crafted/public/case-studies/feature-drift-mcr.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A detector is only interesting if it stays quiet when drift is destroyed; refitted alarm moved from window 1 to 106."}, {"id": "vibe_crafted_public_case_studies_feature_drift_mcr_ddm", "label": "DDM Drift Detector", "file_type": "concept", "source_file": "vibe-crafted/public/case-studies/feature-drift-mcr.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tied the refitted signal at window 1 but alarmed in 2 of 3 permuted controls."}, {"id": "vibe_crafted_public_case_studies_feature_drift_mcr_adwin", "label": "ADWIN Drift Detector", "file_type": "concept", "source_file": "vibe-crafted/public/case-studies/feature-drift-mcr.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alarmed at window 14, after degradation; silent in all permuted controls."}, {"id": "vibe_crafted_public_case_studies_feature_drift_mcr_model_class_reliance", "label": "Model Class Reliance (MCR) / Rashomon Set", "file_type": "concept", "source_file": "vibe-crafted/public/case-studies/feature-drift-mcr.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named in the title but no MCR interval was ever estimated; the harness enumerates exact sufficient subsets instead."}], "edges": [{"source": "vibe_crafted_public_case_studies_feature_drift_mcr_case_study", "target": "vibe_crafted_public_case_studies_feature_drift_mcr_feature_drift_dissertation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vibe-crafted/public/case-studies/feature-drift-mcr.html", "source_location": null, "weight": 1.0}, {"source": "vibe_crafted_public_case_studies_feature_drift_mcr_feature_drift_dissertation", "target": "vibe_crafted_public_case_studies_feature_drift_mcr_uon_msc_business_analytics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vibe-crafted/public/case-studies/feature-drift-mcr.html", "source_location": null, "weight": 1.0}, {"source": "vibe_crafted_public_case_studies_feature_drift_mcr_feature_drift_dissertation", "target": "vibe_crafted_public_case_studies_feature_drift_mcr_frozen_model_conditional_drift", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vibe-crafted/public/case-studies/feature-drift-mcr.html", "source_location": null, "weight": 1.0}, {"source": "vibe_crafted_public_case_studies_feature_drift_mcr_feature_drift_dissertation", "target": "vibe_crafted_public_case_studies_feature_drift_mcr_boolean_harness", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vibe-crafted/public/case-studies/feature-drift-mcr.html", "source_location": null, "weight": 1.0}, {"source": "vibe_crafted_public_case_studies_feature_drift_mcr_feature_drift_dissertation", "target": "vibe_crafted_public_case_studies_feature_drift_mcr_rotating_hyperplane", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vibe-crafted/public/case-studies/feature-drift-mcr.html", "so